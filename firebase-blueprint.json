  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Verified UniNest administrator UIDs."
    },
    "/platform_stats/{statId}": {
      "schema": { "$ref": "#/entities/PlatformStats" },
      "description": "UniNest 10% Marketplace Commission & order tally."
    },
    "/vendors/{vendorId}": {
      "schema": { "$ref": "#/entities/Vendor" },
      "description": "Public UniNest Marketplace vendor storefronts."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Public Marketplace catalog items with automatic 10% fee."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Single & Cart customer orders awaiting Vendor Admin confirmation."
    },
    "/featured_requests/{reqId}": {
      "schema": { "$ref": "#/entities/FeaturedRequest" },
      "description": "Top Vendor boost payment requests awaiting Vendor Admin confirmation."
    },
    "/withdrawals/{withdrawalId}": {
      "schema": { "$ref": "#/entities/Withdrawal" },
      "description": "Vendor wallet withdrawal requests reviewed by Vendor Admin."
    },
    "/project_helpers/{helperId}": {
      "schema": { "$ref": "#/entities/ProjectHelper" },
