      "required": ["id", "name", "location", "specialty", "photo", "bio", "maskedPhone", "unlockFee", "jobsCompleted", "active", "createdAt", "updatedAt"]
    },
    "ScoutPrivateContact": {
      "title": "ScoutPrivateContact",
