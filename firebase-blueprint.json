        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fresherUid", "fresherName", "phone", "university", "faculty", "task", "preferredDate", "paymentRef", "amount", "paymentStatus", "status", "createdDateLabel", "createdAt", "updatedAt"]
    },
    "PartnerAccount": {
      "title": "PartnerAccount",
      "description": "Protected partner/admin role profile managed by platform admins.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 0, "maxLength": 128 },
        "role": { "type": "string", "enum": ["vendor_admin", "scout_admin", "project_helper_admin", "vendor", "project_helper", "scout"] },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "loginName": { "type": "string", "minLength": 2, "maxLength": 60 },
        "code": { "type": "string", "minLength": 4, "maxLength": 60 },
        "location": { "type": "string", "minLength": 0, "maxLength": 160 },
        "university": { "type": "string", "minLength": 0, "maxLength": 120 },
        "helperId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "avatar": { "type": "string", "minLength": 0, "maxLength": 250000 },
        "balance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "role", "name", "loginName", "code", "createdAt", "updatedAt"]
    },
    "PartnerAuthLookup": {
      "title": "PartnerAuthLookup",
      "description": "SHA-256 keyed lookup document mapping hashed loginName:code credentials to a partner account ID without exposing credential lists.",
      "type": "object",
