        "role": { "type": "string", "enum": ["vendor_admin", "scout_admin", "project_helper_admin", "vendor", "project_helper", "scout"] },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "location": { "type": "string", "minLength": 0, "maxLength": 160 },
        "university": { "type": "string", "minLength": 0, "maxLength": 120 },
        "helperId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "accountId", "role", "name", "updatedAt"]
