    "ServiceSubmission": {
      "title": "ServiceSubmission",
      "description": "Online STS savings registration, Project Work brief, Student Job application, Custom Market Order, or Inquiry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
