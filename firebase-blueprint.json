        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "phone": { "type": "string", "minLength": 6, "maxLength": 40 },
        "whatsapp": { "type": "string", "minLength": 6, "maxLength": 30 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "phone", "whatsapp", "updatedAt"]
    },
    "ScoutUnlock": {
      "title": "ScoutUnlock",
      "description": "Fresher payment submission to unlock a Campus Scout's direct contact, confirmed by Scouts Admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "scoutId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "scoutName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "studentName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "studentPhone": { "type": "string", "minLength": 6, "maxLength": 40 },
        "task": { "type": "string", "minLength": 2, "maxLength": 240 },
        "paymentRef": { "type": "string", "minLength": 2, "maxLength": 160 },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending_confirmation", "confirmed", "rejected"] },
        "createdDateLabel": { "type": "string", "minLength": 1, "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "studentUid", "scoutId", "scoutName", "studentName", "studentPhone", "task", "paymentRef", "amount", "status", "createdDateLabel", "createdAt", "updatedAt"]
    },
    "ScoutBooking": {
      "title": "ScoutBooking",
      "description": "Fresher clearance & escort booking confirmed and assigned by Scouts Admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fresherUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fresherName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "phone": { "type": "string", "minLength": 6, "maxLength": 40 },
        "university": { "type": "string", "minLength": 2, "maxLength": 120 },
        "faculty": { "type": "string", "minLength": 2, "maxLength": 160 },
        "task": { "type": "string", "minLength": 2, "maxLength": 200 },
        "preferredDate": { "type": "string", "minLength": 2, "maxLength": 80 },
        "notes": { "type": "string", "minLength": 0, "maxLength": 500 },
