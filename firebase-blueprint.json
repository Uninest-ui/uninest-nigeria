{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized UniNest platform administrator.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 150 },
        "role": { "type": "string", "enum": ["super_admin", "vendor_admin", "scout_admin", "project_helper_admin"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "name", "createdAt"]
    },
    "PlatformStats": {
      "title": "PlatformStats",
      "description": "Platform-wide 10% marketplace commission ledger summary.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "vendorAdminBalance": { "type": "number" },
        "totalConfirmedOrders": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "vendorAdminBalance", "totalConfirmedOrders", "updatedAt"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Public UniNest Marketplace vendor shop storefront profile (non-PII).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 0, "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "university": { "type": "string", "minLength": 2, "maxLength": 120 },
        "location": { "type": "string", "minLength": 2, "maxLength": 160 },
        "shopTagline": { "type": "string", "minLength": 0, "maxLength": 300 },
        "avatar": { "type": "string", "minLength": 0, "maxLength": 250000 },
        "isFeatured": { "type": "boolean" },
        "featuredPlan": { "type": "string", "minLength": 0, "maxLength": 80 },
        "featuredUntil": { "type": "string", "minLength": 0, "maxLength": 60 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "university", "location", "isFeatured", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Marketplace product listing published by a verified vendor (includes 10% fee markup).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "vendorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "vendorOwnerUid": { "type": "string", "minLength": 0, "maxLength": 128 },
        "title": { "type": "string", "minLength": 2, "maxLength": 140 },
        "category": { "type": "string", "enum": ["Food", "Cakes", "Gadgets", "Tailors & Cloths", "Shoes"] },
        "vendorPrice": { "type": "number" },
        "price": { "type": "number" },
        "image": { "type": "string", "minLength": 1, "maxLength": 250000 },
        "description": { "type": "string", "minLength": 0, "maxLength": 600 },
        "status": { "type": "string", "enum": ["published", "removed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "vendorId", "title", "category", "vendorPrice", "price", "image", "description", "status", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Marketplace customer order awaiting Vendor Admin transfer confirmation before payout split.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "batchId": { "type": "string", "minLength": 0, "maxLength": 128 },
        "buyerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productTitle": { "type": "string", "minLength": 2, "maxLength": 140 },
        "vendorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "vendorName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "vendorOwnerUid": { "type": "string", "minLength": 0, "maxLength": 128 },
        "qty": { "type": "number" },
        "total": { "type": "number" },
        "vendorShare": { "type": "number" },
        "adminCommission": { "type": "number" },
        "customerName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "customerPhone": { "type": "string", "minLength": 6, "maxLength": 40 },
        "customerLocation": { "type": "string", "minLength": 2, "maxLength": 200 },
        "deliveryWindow": { "type": "string", "minLength": 2, "maxLength": 80 },
        "paymentRef": { "type": "string", "minLength": 2, "maxLength": 160 },
        "paymentStatus": { "type": "string", "enum": ["pending_confirmation", "confirmed", "rejected"] },
        "createdDateLabel": { "type": "string", "minLength": 1, "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "buyerUid", "productId", "productTitle", "vendorId", "vendorName", "qty", "total", "vendorShare", "adminCommission", "customerName", "customerPhone", "customerLocation", "deliveryWindow", "paymentRef", "paymentStatus", "createdDateLabel", "createdAt", "updatedAt"]
    },
    "FeaturedRequest": {
      "title": "FeaturedRequest",
      "description": "Vendor request for Top Vendor Marketplace placement awaiting Vendor Admin confirmation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requesterUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "vendorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "vendorName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "plan": { "type": "string", "minLength": 2, "maxLength": 80 },
        "amount": { "type": "number" },
        "method": { "type": "string", "minLength": 2, "maxLength": 80 },
        "paymentRef": { "type": "string", "minLength": 0, "maxLength": 160 },
        "status": { "type": "string", "enum": ["pending_confirmation", "confirmed", "rejected"] },
        "dateLabel": { "type": "string", "minLength": 1, "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "requesterUid", "vendorId", "vendorName", "plan", "amount", "method", "status", "dateLabel", "createdAt", "updatedAt"]
    },
    "Withdrawal": {
      "title": "Withdrawal",
      "description": "Vendor wallet payout request reviewed by Vendor Admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requesterUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "vendorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "vendorName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "location": { "type": "string", "minLength": 0, "maxLength": 160 },
        "amount": { "type": "number" },
        "bank": { "type": "string", "minLength": 4, "maxLength": 180 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdDateLabel": { "type": "string", "minLength": 1, "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "requesterUid", "vendorId", "vendorName", "amount", "bank", "status", "createdDateLabel", "createdAt", "updatedAt"]
    },
    "ProjectHelper": {
      "title": "ProjectHelper",
      "description": "Public academic thesis and project specialist profile (masked phone only).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 0, "maxLength": 128 },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "specialty": { "type": "string", "minLength": 2, "maxLength": 200 },
        "campus": { "type": "string", "minLength": 2, "maxLength": 120 },
        "photo": { "type": "string", "minLength": 1, "maxLength": 250000 },
        "bio": { "type": "string", "minLength": 0, "maxLength": 600 },
        "maskedPhone": { "type": "string", "minLength": 4, "maxLength": 40 },
        "unlockFee": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "specialty", "campus", "photo", "bio", "maskedPhone", "unlockFee", "active", "createdAt", "updatedAt"]
    },
    "HelperPrivateContact": {
      "title": "HelperPrivateContact",
      "description": "Protected helper direct phone, WhatsApp, and email unlocked only after Admin payment confirmation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "phone": { "type": "string", "minLength": 6, "maxLength": 40 },
        "whatsapp": { "type": "string", "minLength": 6, "maxLength": 30 },
        "email": { "type": "string", "minLength": 3, "maxLength": 150 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "phone", "whatsapp", "email", "updatedAt"]
    },
    "HelperUnlock": {
      "title": "HelperUnlock",
      "description": "Student payment submission to unlock a Project Helper's direct contact, confirmed by Project Helper Admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "helperId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "helperName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "studentName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "studentPhone": { "type": "string", "minLength": 6, "maxLength": 40 },
        "paymentRef": { "type": "string", "minLength": 2, "maxLength": 160 },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending_confirmation", "confirmed", "rejected"] },
        "createdDateLabel": { "type": "string", "minLength": 1, "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "studentUid", "helperId", "helperName", "studentName", "studentPhone", "paymentRef", "amount", "status", "createdDateLabel", "createdAt", "updatedAt"]
    },
    "PublicReview": {
      "title": "PublicReview",
      "description": "Verified student review on a Project Helper or Campus Scout profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "author": { "type": "string", "minLength": 2, "maxLength": 80 },
        "rating": { "type": "number" },
        "text": { "type": "string", "minLength": 2, "maxLength": 1000 },
        "dateLabel": { "type": "string", "minLength": 1, "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "targetId", "authorUid", "author", "rating", "text", "dateLabel", "createdAt"]
    },
    "CampusScout": {
      "title": "CampusScout",
